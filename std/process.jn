
extern *jinn_popen_read(cmd as %i8, buf as %i8, buf_size as i64, exit_code as %i32) returns i64
extern *jinn_system(cmd as %i8) returns i32
extern *jinn_exec_capture(prog as %i8, argv as %i8, buf as %i8, buf_size as i64, exit_code as %i32) returns i64
extern *jinn_spawn_capture(vec_ptr as %i8, buf as %i8, buf_size as i64, exit_code as %i32) returns i64
extern *jinn_spawn_exec(vec_ptr as %i8, exit_code as %i32) returns i32
extern *malloc(size as i64) returns %i8
extern *free(ptr as %i8)

type ProcessResult
    output as String
    exit_code as i32

    *ok returns bool
        self.exit_code equals 0

    *lines returns Vec of String
        self.output.split("\n")

*run(cmd as String) returns ProcessResult
    buf_size is 65536
    buf is extern.malloc(buf_size)
    exit_code is 0
    n is extern.jinn_popen_read(%cmd, buf, buf_size, %exit_code as %i32)
    if n < 0
        extern.free(buf)
        return ProcessResult(output is "", exit_code is -1)
    if n >= buf_size - 1
        extern.free(buf)
        return ProcessResult(output is "[output truncated at 64KB]", exit_code is exit_code)
    out is __string_from_raw(buf, n, buf_size)
    ProcessResult(output is out, exit_code is exit_code)

*exec(cmd as String) returns i32
    extern.jinn_system(%cmd)

*capture(cmd as String) returns String
    result is run(cmd)
    out is result.output
    if out.length > 0 and out.char_at(out.length - 1) equals 10
        return out.slice(0, out.length - 1)
    out

*lines(cmd as String) returns Vec of String
    result is run(cmd)
    if result.exit_code neq 0
        return vec()
    out is result.output
    if out.length > 0 and out.char_at(out.length - 1) equals 10
        out is out.slice(0, out.length - 1)
    out.split("\n")

*succeeds(cmd as String) returns bool
    extern.jinn_system(%cmd) equals 0

*try_run(cmd as String) returns String
    result is run(cmd)
    if result.exit_code neq 0
        return ""
    result.output

*cmd(parts as Vec of String) returns String
    result is ""
    loop parts
        if $$ > 0
            result is result + " "
        if $.find(" ") >= 0 or $.find("'") >= 0
            result is result + "'" + $.replace("'", "'\\''") + "'"
        else
            result is result + $
    result

*pipe(commands as Vec of String) returns ProcessResult
    joined is ""
    loop commands
        if $$ > 0
            joined is joined + " | "
        joined is joined + $
    run(joined)

*with_env(name as String, value as String, command as String) returns ProcessResult
    run(name + "=" + value + " " + command)


*run_argv(prog as String, args as Vec of String) returns ProcessResult
    buf_size is 65536
    buf is extern.malloc(buf_size)
    exit_code is 0
    argv is [prog]
    loop args
        argv.push($)
    n is extern.jinn_spawn_capture(%argv, buf, buf_size, %exit_code as %i32)
    if n < 0
        extern.free(buf)
        return ProcessResult(output is "", exit_code is -1)
    if n >= buf_size - 1
        extern.free(buf)
        return ProcessResult(output is "[output truncated at 64KB]", exit_code is exit_code)
    out is __string_from_raw(buf, n, buf_size)
    ProcessResult(output is out, exit_code is exit_code)

*spawn_exec(prog as String, args as Vec of String) returns i32
    exit_code is 0
    argv is [prog]
    loop args
        argv.push($)
    extern.jinn_spawn_exec(%argv, %exit_code as %i32)
    exit_code

*spawn_lines(prog as String, args as Vec of String) returns Vec of String
    result is run_argv(prog, args)
    if result.exit_code neq 0
        return vec()
    out is result.output
    if out.length > 0 and out.char_at(out.length - 1) equals 10
        out is out.slice(0, out.length - 1)
    out.split("\n")

*spawn_succeeds(prog as String, args as Vec of String) returns bool
    result is run_argv(prog, args)
    result.exit_code equals 0
