

extern *jinn_socket(domain as i32, kind as i32, protocol as i32) returns i32
extern *bind(fd as i32, addr as %i8, addrlen as i32) returns i32
extern *listen_sock(fd as i32, backlog as i32) returns i32
extern *accept(fd as i32, addr as %i8, addrlen as %i32) returns i32
extern *connect(fd as i32, addr as %i8, addrlen as i32) returns i32
extern *jinn_send(fd as i32, buf as %i8, len as i64, flags as i32) returns i64
extern *jinn_recv(fd as i32, buf as %i8, len as i64, flags as i32) returns i64
extern *jinn_close(fd as i32) returns i32
extern *setsockopt(fd as i32, level as i32, optname as i32, optval as %i8, optlen as i32) returns i32
extern *htons(port as i16) returns i16
extern *inet_pton(af as i32, src as %i8, dst as %i8) returns i32
extern *malloc(size as i64) returns %i8
extern *free(ptr as %i8)
extern *memset(s as %i8, c as i32, n as i64) returns %i8
extern *memcpy(dst as %i8, src as %i8, n as i64) returns %i8
extern *jinn_sendto(fd as i32, buf as %i8, len as i64, flags as i32, addr as %i8, addrlen as i32) returns i64
extern *jinn_recvfrom(fd as i32, buf as %i8, len as i64, flags as i32, addr as %i8, addrlen as %i32) returns i64
extern *strlen(s as %i8) returns i64
extern *shutdown(fd as i32, how as i32) returns i32

err NetError
    BadPort
    SocketFailed
    BindFailed
    ListenFailed
    ConnectFailed
    AcceptFailed

AF_INET is 2
SOCK_STREAM is 1
SOCK_DGRAM is 2
SOL_SOCKET is 1
SO_REUSEADDR is 2
SOCKADDR_IN_SIZE is 16
SHUT_RDWR is 2


type TcpListener @resource
    fd as i32
    port as i64

    *accept_client returns TcpStream ! NetError
        client_fd is extern.accept(self.fd, 0 as %i8, 0 as %i32)
        if client_fd < 0
            err AcceptFailed
        TcpStream(fd is client_fd)

    *shut
        if self.fd >= 0
            extern.jinn_close(self.fd)
            self.fd is -1 as i32

    *drop
        self.shut()

type TcpStream @resource
    fd as i32

    *read(max_bytes)
        buf is extern.malloc(max_bytes + 1)
        n is extern.jinn_recv(self.fd, buf, max_bytes, 0)
        if n <= 0
            extern.free(buf)
            return ""
        __string_from_raw(buf, n, max_bytes + 1)

    *write(data as String)
        extern.jinn_send(self.fd, %data, data.length, 0)

    *write_all(data as String)
        sent is 0
        while sent < data.length
            remaining is data.slice(sent, data.length)
            n is extern.jinn_send(self.fd, %remaining, remaining.length, 0)
            if n <= 0
                return false
            sent is sent + n
        true

    *shut
        if self.fd >= 0
            extern.shutdown(self.fd, SHUT_RDWR)
            extern.jinn_close(self.fd)
            self.fd is -1 as i32

    *drop
        self.shut()


type UdpSocket @resource
    fd as i32

    *send_to(data as String, host as String, port as i64)
        addr is __make_sockaddr(host, port)
        extern.jinn_sendto(self.fd, %data, data.length, 0, addr, SOCKADDR_IN_SIZE)
        extern.free(addr)

    *recv_from(max_bytes)
        buf is extern.malloc(max_bytes + 1)
        n is extern.jinn_recvfrom(self.fd, buf, max_bytes, 0, 0 as %i8, 0 as %i32)
        if n <= 0
            extern.free(buf)
            return ""
        __string_from_raw(buf, n, max_bytes + 1)

    *shut
        if self.fd >= 0
            extern.jinn_close(self.fd)
            self.fd is -1 as i32

    *drop
        self.shut()


*__make_sockaddr(host as String, port as i64) returns %i8
    addr is extern.malloc(SOCKADDR_IN_SIZE)
    extern.memset(addr, 0, SOCKADDR_IN_SIZE)
    family is AF_INET as i16
    extern.memcpy(addr, %family as %i8, 2)
    net_port is extern.htons(port as i16)
    extern.memcpy(addr + 2, %net_port as %i8, 2)
    extern.inet_pton(AF_INET, %host, addr + 4)
    addr


*tcp_listen(host as String, port as i64) returns TcpListener ! NetError
    if port < 0 or port > 65535
        err BadPort
    fd is extern.jinn_socket(AF_INET, SOCK_STREAM, 0)
    if fd < 0
        err SocketFailed
    one is 1
    extern.setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, %one as %i8, 4)
    addr is __make_sockaddr(host, port)
    if extern.bind(fd, addr, SOCKADDR_IN_SIZE) < 0
        extern.free(addr)
        extern.jinn_close(fd)
        err BindFailed
    extern.free(addr)
    if extern.listen_sock(fd, 128) < 0
        extern.jinn_close(fd)
        err ListenFailed
    TcpListener(fd is fd, port is port)

*tcp_connect(host as String, port as i64) returns TcpStream ! NetError
    if port < 0 or port > 65535
        err BadPort
    fd is extern.jinn_socket(AF_INET, SOCK_STREAM, 0)
    if fd < 0
        err SocketFailed
    addr is __make_sockaddr(host, port)
    if extern.connect(fd, addr, SOCKADDR_IN_SIZE) < 0
        extern.free(addr)
        extern.jinn_close(fd)
        err ConnectFailed
    extern.free(addr)
    TcpStream(fd is fd)


extern *jinn_dns_resolve(host as %i8, buf as %i8, buf_len as i32) returns i32
extern *jinn_dns_resolve_all(host as %i8, buf as %i8, buf_len as i32) returns i32

*resolve(host as String) returns String
    buf is extern.malloc(256)
    extern.memset(buf, 0, 256)
    result is extern.jinn_dns_resolve(%host, buf, 255)
    if result < 0
        extern.free(buf)
        return ""
    addr is __string_from_ptr(buf)
    extern.free(buf)
    addr

*resolve_all(host as String) returns Vec of String
    buf is extern.malloc(4096)
    extern.memset(buf, 0, 4096)
    count is extern.jinn_dns_resolve_all(%host, buf, 4095)
    if count equals 0
        extern.free(buf)
        return vec()
    raw is __string_from_ptr(buf)
    extern.free(buf)
    raw.split("\n")


AF_INET6 is 10
SOCKADDR_IN6_SIZE is 28

*__make_sockaddr6(host as String, port as i64) returns %i8
    addr is extern.malloc(SOCKADDR_IN6_SIZE)
    extern.memset(addr, 0, SOCKADDR_IN6_SIZE)
    family is AF_INET6 as i16
    extern.memcpy(addr, %family as %i8, 2)
    net_port is extern.htons(port as i16)
    extern.memcpy(addr + 2, %net_port as %i8, 2)
    extern.inet_pton(AF_INET6, %host, addr + 8)
    addr

*__is_ipv6(host as String) returns bool
    host.find(":") >= 0

*tcp_connect_auto(host as String, port as i64) returns TcpStream ! NetError
    resolved is resolve(host)
    if resolved.length equals 0
        resolved is host
    if __is_ipv6(resolved)
        fd is extern.jinn_socket(AF_INET6, SOCK_STREAM, 0)
        if fd < 0
            err SocketFailed
        addr is __make_sockaddr6(resolved, port)
        if extern.connect(fd, addr, SOCKADDR_IN6_SIZE) < 0
            extern.free(addr)
            extern.jinn_close(fd)
            err ConnectFailed
        extern.free(addr)
        return TcpStream(fd is fd)
    tcp_connect(resolved, port)


*udp_bind(host as String, port as i64) returns UdpSocket ! NetError
    fd is extern.jinn_socket(AF_INET, SOCK_DGRAM, 0)
    if fd < 0
        err SocketFailed
    addr is __make_sockaddr(host, port)
    if extern.bind(fd, addr, SOCKADDR_IN_SIZE) < 0
        extern.free(addr)
        extern.jinn_close(fd)
        err BindFailed
    extern.free(addr)
    UdpSocket(fd is fd)

*udp_open returns UdpSocket ! NetError
    fd is extern.jinn_socket(AF_INET, SOCK_DGRAM, 0)
    if fd < 0
        err SocketFailed
    UdpSocket(fd is fd)
