
*parse(text as String) returns Vec of Vec of String
    rows as Vec of Vec of String is vec()
    n is text.byte_count
    if n equals 0
        return rows
    row as Vec of String is vec()
    i is 0
    in_quotes is false
    start is 0
    field is ""
    had_parts is false
    while i < n
        ch is text.char_at(i)
        if in_quotes
            if ch equals 34
                if i + 1 < n and text.char_at(i + 1) equals 34
                    field is field + text.slice(start, i + 1)
                    i is i + 2
                    start is i
                    had_parts is true
                else
                    field is field + text.slice(start, i)
                    in_quotes is false
                    i is i + 1
                    start is i
                    had_parts is true
            else
                i is i + 1
        else
            if ch equals 34
                if i > start
                    field is field + text.slice(start, i)
                had_parts is true
                in_quotes is true
                i is i + 1
                start is i
            elif ch equals 44
                row.push(__finish_field(text, field, start, i, had_parts))
                field is ""
                had_parts is false
                i is i + 1
                start is i
            elif ch equals 10
                row.push(__finish_field(text, field, start, i, had_parts))
                field is ""
                had_parts is false
                rows.push(row)
                row is vec()
                i is i + 1
                start is i
            elif ch equals 13
                row.push(__finish_field(text, field, start, i, had_parts))
                field is ""
                had_parts is false
                rows.push(row)
                row is vec()
                i is i + 1
                if i < n and text.char_at(i) equals 10
                    i is i + 1
                start is i
            else
                i is i + 1
    last is __finish_field(text, field, start, i, had_parts)
    need_push is false
    if last.byte_count > 0
        need_push is true
    if row.length > 0
        need_push is true
    if need_push
        row.push(last)
        rows.push(row)
    rows

*__finish_field(text as String, field as String, start as i64, end as i64, had_parts as bool) returns String
    if not had_parts
        return text.slice(start, end)
    if end > start
        return field + text.slice(start, end)
    field

*stringify(rows as Vec of Vec of String) returns String
    result is ""
    loop rows
        loop $
            if $$ > 0
                result is result + ","
            result is result + escape_field($)
        result is result + "\n"
    result

*escape_field(field as String) returns String
    n is field.byte_count
    needs_quote is false
    i is 0
    while i < n
        ch is field.char_at(i)
        if ch equals 44 or ch equals 34 or ch equals 10 or ch equals 13
            needs_quote is true
            break
        i is i + 1
    if needs_quote is false
        return field
    result is '"'
    start is 0
    i is 0
    while i < n
        if field.char_at(i) equals 34
            result is result + field.slice(start, i + 1) + '"'
            start is i + 1
        i is i + 1
    if start < n
        result is result + field.slice(start, n)
    result + '"'

*get_column(rows as Vec of Vec of String, header as String) returns Vec of String
    empty as Vec of String is vec()
    if rows.length < 1
        return empty
    col_idx is -1
    loop rows
        if $$ equals 0
            row is $
            loop row
                if $ equals header
                    col_idx is $$
                    break
        break
    if col_idx < 0
        return empty
    result as Vec of String is vec()
    loop rows
        if $$ > 0
            if col_idx < $.length
                result.push($.get(col_idx))
            else
                result.push("")
    result

*to_records(rows as Vec of Vec of String) returns Vec of Map of String
    records as Vec of Map of String is vec()
    if rows.length < 2
        return records
    headers is copy rows.get(0)
    loop rows
        if $$ > 0
            row is $
            record as Map of String is map()
            loop headers
                if $$ < row.length
                    record.set($, row.get($$))
                else
                    record.set($, "")
            records.push(record)
    records


type Reader
    text as String
    pos as i64
    done as bool

    *has_next returns bool
        if self.done
            return false
        self.pos < self.text.length

    *next_row returns Vec of String
        n is self.text.byte_count
        if self.pos >= n
            self.done is true
            return vec()
        row as Vec of String is vec()
        field is ""
        in_quotes is false
        start is self.pos
        had_parts is false
        while self.pos < n
            ch is self.text.char_at(self.pos)
            if in_quotes
                if ch equals 34
                    if self.pos + 1 < n and self.text.char_at(self.pos + 1) equals 34
                        field is field + self.text.slice(start, self.pos + 1)
                        self.pos is self.pos + 2
                        start is self.pos
                        had_parts is true
                    else
                        field is field + self.text.slice(start, self.pos)
                        in_quotes is false
                        self.pos is self.pos + 1
                        start is self.pos
                        had_parts is true
                else
                    self.pos is self.pos + 1
            else
                if ch equals 34
                    if self.pos > start
                        field is field + self.text.slice(start, self.pos)
                    had_parts is true
                    in_quotes is true
                    self.pos is self.pos + 1
                    start is self.pos
                elif ch equals 44
                    row.push(__finish_field(self.text, field, start, self.pos, had_parts))
                    field is ""
                    had_parts is false
                    self.pos is self.pos + 1
                    start is self.pos
                elif ch equals 10
                    row.push(__finish_field(self.text, field, start, self.pos, had_parts))
                    self.pos is self.pos + 1
                    return row
                elif ch equals 13
                    row.push(__finish_field(self.text, field, start, self.pos, had_parts))
                    self.pos is self.pos + 1
                    if self.pos < n and self.text.char_at(self.pos) equals 10
                        self.pos is self.pos + 1
                    return row
                else
                    self.pos is self.pos + 1
        last is __finish_field(self.text, field, start, self.pos, had_parts)
        has_data is false
        if last.byte_count > 0
            has_data is true
        if row.length > 0
            has_data is true
        if has_data
            row.push(last)
        self.done is true
        row

*reader(text as String) returns Reader
    Reader(text is text, pos is 0, done is false)
