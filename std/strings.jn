
extern *malloc(size as i64) returns %i8
extern *memcpy(dst as %i8, src as %i8, n as i64) returns %i8


type StringBuilder
    parts as Vec of String
    total as i64

    *write(s as String) returns i64
        self.parts.push(s)
        self.total is self.total + s.byte_count

    *write_line(s as String)
        self.parts.push(s)
        self.parts.push('\n')
        self.total is self.total + s.byte_count + 1

    *write_byte(b as i64)
        c is byte(b & 255)
        self.parts.push(c)
        self.total is self.total + 1

    *to_string returns String
        if self.parts.length equals 0
            return ''
        if self.total equals 0
            return ''
        buf is extern.malloc(self.total + 1)
        offset is 0 as i64
        loop self.parts
            extern.memcpy(buf + offset, %$ as %i8, $.byte_count)
            offset is offset + $.byte_count
        __string_from_raw(buf, self.total, self.total + 1)

    *length returns i64
        self.total

    *clear
        self.parts is vec()
        self.total is 0

*builder returns StringBuilder
    StringBuilder(parts is vec(), total is 0)

*string_builder returns StringBuilder
    builder()


*is_space(c as i64) returns bool
    c equals 32 or c equals 9 or c equals 10 or c equals 13 or c equals 11 or c equals 12

*trim(s as String) returns String
    n is s.byte_count
    lo is 0
    while lo < n and is_space(s.char_at(lo))
        lo is lo + 1
    hi is n
    while hi > lo and is_space(s.char_at(hi - 1))
        hi is hi - 1
    s.slice(lo, hi)

*trim_left(s as String) returns String
    n is s.byte_count
    lo is 0
    while lo < n and is_space(s.char_at(lo))
        lo is lo + 1
    s.slice(lo, n)

*trim_right(s as String) returns String
    hi is s.byte_count
    while hi > 0 and is_space(s.char_at(hi - 1))
        hi is hi - 1
    s.slice(0, hi)

*trim_chars(s as String, chars as String) returns String
    n is s.byte_count
    lo is 0
    while lo < n and __contains_byte(chars, s.char_at(lo))
        lo is lo + 1
    hi is n
    while hi > lo and __contains_byte(chars, s.char_at(hi - 1))
        hi is hi - 1
    s.slice(lo, hi)


*replace(s as String, from as String, to as String) returns String
    fn is from.byte_count
    if fn equals 0
        return s
    n is s.byte_count
    sb is builder()
    start is 0
    i is 0
    while i < n
        if i + fn <= n and __region_eq(s, i, from)
            if i > start
                sb.write(s.slice(start, i))
            sb.write(to)
            i is i + fn
            start is i
        else
            i is i + 1
    if start equals 0
        return s
    if start < n
        sb.write(s.slice(start, n))
    sb.to_string()

*replace_first(s as String, from as String, to as String) returns String
    if from.byte_count equals 0
        return s
    pos is s.find(from)
    if pos < 0
        return s
    s.slice(0, pos) + to + s.slice(pos + from.byte_count, s.byte_count)


*split_lines(s as String) returns Vec of String
    out as Vec of String is vec()
    n is s.byte_count
    start is 0
    i is 0
    while i < n
        c is s.char_at(i)
        if c equals 10
            out.push(s.slice(start, i))
            i is i + 1
            start is i
        elif c equals 13
            out.push(s.slice(start, i))
            i is i + 1
            if i < n and s.char_at(i) equals 10
                i is i + 1
            start is i
        else
            i is i + 1
    if start < n
        out.push(s.slice(start, n))
    out

*split_whitespace(s as String) returns Vec of String
    out as Vec of String is vec()
    n is s.byte_count
    start is -1
    i is 0
    while i < n
        if is_space(s.char_at(i))
            if start >= 0
                out.push(s.slice(start, i))
                start is -1
        else
            if start < 0
                start is i
        i is i + 1
    if start >= 0
        out.push(s.slice(start, n))
    out


*to_lower(s as String) returns String
    s.to_lower()

*to_upper(s as String) returns String
    s.to_upper()

*capitalize(s as String) returns String
    if s.byte_count equals 0
        return s
    c is s.char_at(0)
    head is c >= 97 and c <= 122 ? chr(c - 32) ! s.slice(0, 1)
    head + s.slice(1, s.byte_count).to_lower()

*title_case(s as String) returns String
    n is s.byte_count
    sb is builder()
    cap_next is true
    start is 0
    i is 0
    while i < n
        c is s.char_at(i)
        if is_space(c) or c equals 45 or c equals 95
            cap_next is true
        elif cap_next and c >= 97 and c <= 122
            if i > start
                sb.write(s.slice(start, i))
            sb.write_byte(c - 32)
            start is i + 1
            cap_next is false
        elif (not cap_next) and c >= 65 and c <= 90
            if i > start
                sb.write(s.slice(start, i))
            sb.write_byte(c + 32)
            start is i + 1
        else
            cap_next is false
        i is i + 1
    if start equals 0
        return s
    if start < n
        sb.write(s.slice(start, n))
    sb.to_string()


*snake_to_camel(s as String) returns String
    n is s.byte_count
    sb is builder()
    cap_next is false
    start is 0
    i is 0
    while i < n
        c is s.char_at(i)
        if c equals 95
            if i > start
                sb.write(s.slice(start, i))
            start is i + 1
            cap_next is true
        elif cap_next and c >= 97 and c <= 122
            if i > start
                sb.write(s.slice(start, i))
            sb.write_byte(c - 32)
            start is i + 1
            cap_next is false
        else
            cap_next is false
        i is i + 1
    if start equals 0
        return s
    if start < n
        sb.write(s.slice(start, n))
    sb.to_string()

*camel_to_snake(s as String) returns String
    n is s.byte_count
    sb is builder()
    start is 0
    i is 0
    while i < n
        c is s.char_at(i)
        if c >= 65 and c <= 90
            if i > start
                sb.write(s.slice(start, i))
            if i > 0
                sb.write("_")
            sb.write_byte(c + 32)
            start is i + 1
        i is i + 1
    if start equals 0
        return s
    if start < n
        sb.write(s.slice(start, n))
    sb.to_string()


*contains(s as String, sub as String) returns bool
    s.find(sub) >= 0

*is_blank(s as String) returns bool
    i is 0
    while i < s.byte_count
        if not is_space(s.char_at(i))
            return false
        i is i + 1
    true

*is_alpha(s as String) returns bool
    n is s.byte_count
    if n equals 0
        return false
    i is 0
    while i < n
        c is s.char_at(i)
        if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122))
            return false
        i is i + 1
    true

*is_digit(s as String) returns bool
    n is s.byte_count
    if n equals 0
        return false
    i is 0
    while i < n
        c is s.char_at(i)
        if c < 48 or c > 57
            return false
        i is i + 1
    true


*reverse(s as String) returns String
    n is s.byte_count
    if n <= 1
        return s
    sb is builder()
    end is n
    i is n - 1
    while i >= 0
        c is s.char_at(i)
        if (c & 192) neq 128
            sb.write(s.slice(i, end))
            end is i
        i is i - 1
    sb.to_string()

*count(s as String, sub as String) returns i64
    sn is sub.byte_count
    if sn equals 0
        return 0
    n is s.byte_count
    c is 0
    i is 0
    while i + sn <= n
        if __region_eq(s, i, sub)
            c is c + 1
            i is i + sn
        else
            i is i + 1
    c


*__region_eq(s as String, off as i64, needle as String) returns bool
    i is 0
    n is needle.byte_count
    while i < n
        if s.char_at(off + i) neq needle.char_at(i)
            return false
        i is i + 1
    true

*__contains_byte(chars as View of u8, b as i64) returns bool
    for c in chars
        if (c as i64) equals b
            return true
    false
