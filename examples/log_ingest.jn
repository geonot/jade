
err ParseError
    Empty
    BadLine(String)
    BadStatus(String)
    BadBytes(String)

err IngestError
    Parse(ParseError)
    Store(StoreError)

impl From of ParseError for IngestError
    *from(e as ParseError) returns IngestError is Parse(e)

impl From of StoreError for IngestError
    *from(e as StoreError) returns IngestError is Store(e)

enum Severity
    Info
    Warn
    Error

type Hit
    ip as String
    path as String
    status as i64
    bytes as i64
    sev as Severity

store hits
    ip as String @index
    path as String
    status as i64
    bytes as i64

*to_int(s as String) returns i64 ! ParseError
    s.is_empty() ? err BadBytes(s)
    n is 0
    for i in 0 to s.length
        d is s.char_at(i) - 48
        d < 0 or d > 9 ? err BadBytes(s)
        n is n * 10 + d
    n

*severity(status as i64) returns Severity
    status >= 500 ? Error ! status >= 400 ? Warn ! Info

*bytes_of(field as String) returns i64 ! ParseError
    to_int(field equals '-' ? '0' ! field)

*path_of(line as String) returns String ! ParseError
    q is line.split('"')
    q.len() < 2 ? err BadLine(line)
    parts is q.get(1).split(' ')
    parts.len() < 2 ? err BadLine(line)
    parts.get(1)

*parse(line as String) returns Hit ! ParseError
    line.trim().is_empty() ? err Empty
    f is line.split(' ')
    f.len() < 2 ? err BadLine(line)
    status is to_int(f.get(f.len() - 2)) !! err BadStatus(line)
    bytes is bytes_of(f.get(f.len() - 1))
    path is path_of(line)
    Hit(f.get(0), path, status, bytes, severity(status))

*land(h as Hit) returns i64 ! IngestError
    insert hits h.ip, h.path, h.status, h.bytes

type Report
    accepted as i64
    rejected as i64
    bytes as i64

*absorb(line as String) returns i64 ! IngestError
    h is parse(line)
    land(h)
    h.bytes

*ingest(lines as Vec of String) returns Report
    accepted is 0
    rejected is 0
    total_bytes is 0

    for line in lines
        match absorb(line)
            Ok(n) ?
                accepted += 1
                total_bytes += n
            Err(e) ?
                rejected += 1
                log('reject ({e}): {line}')

    Report(accepted, rejected, total_bytes)

*errors_logged returns i64
    count hits where status >= 500

*main
    raw is [
        '10.0.0.1 - - [10/Oct/2026:13:55:36 -0700] "GET /index.html HTTP/1.1" 200 2326',
        '10.0.0.2 - - [10/Oct/2026:13:55:37 -0700] "GET /missing HTTP/1.1" 404 -',
        '10.0.0.3 - - [10/Oct/2026:13:55:38 -0700] "POST /api/pay HTTP/1.1" 503 91',
        'this is not a log line at all',
        '',
    ]

    r is ingest(raw)
    log('accepted={r.accepted} rejected={r.rejected} bytes={r.bytes}')

    transaction
        delete hits where bytes equals 0

    log('severity(503)={severity(503)}')
    log('server errors: {errors_logged()}')
