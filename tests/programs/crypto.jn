

*fnv1a_hash(data as String)
    hash is 14695981039346656037
    for i from 0 to data.length
        byte is data.char_at(i)
        hash is hash ^ byte
        hash is wrapping_mul(hash, 1099511628211)
    hash


*xor_byte(a, b)
    a ^ b

*xor_encrypt(data as String, key as i64)
    checksum is 0
    for i from 0 to data.length
        byte is data.char_at(i)
        encrypted is xor_byte(byte, key)
        checksum is checksum + encrypted
    checksum


*mix64(x)
    h is x
    h is h ^ (h >> 33)
    h is wrapping_mul(h, -49064778989728563)
    h is h ^ (h >> 33)
    h is wrapping_mul(h, -4265267296055464877)
    h is h ^ (h >> 33)
    h


*simple_crc(data as String)
    crc is 0xFFFFFFFF
    for i from 0 to data.length
        byte is data.char_at(i)
        crc is crc ^ byte
        for bit from 0 to 8
            if crc & 1 equals 1
                crc is (crc >> 1) ^ 0xEDB88320
            else
                crc is crc >> 1
    crc ^ 0xFFFFFFFF


*mod_pow(base, exp, modulus)
    result is 1
    b is base mod modulus
    e is exp
    while e > 0
        if e mod 2 equals 1
            result is (result * b) mod modulus
        e is e / 2
        b is (b * b) mod modulus
    result


*is_probable_prime(n)
    if n < 2
        return false
    if n < 4
        return true
    if n mod 2 equals 0
        return false

    d is n - 1
    r is 0
    while d mod 2 equals 0
        d is d / 2
        r is r + 1

    a is 2
    x is mod_pow(a, d, n)
    if x equals 1 or x equals n - 1
        return true

    for i in 0 to r - 1
        x is (x * x) mod n
        if x equals n - 1
            return true
    false

*main
    h1 is fnv1a_hash('hello')
    h2 is fnv1a_hash('hello')
    h3 is fnv1a_hash('world')
    log(h1 equals h2)
    log(h1 equals h3)
    log(h1)
    log(h3)

    key is 42
    c1 is xor_encrypt('secret', key)
    log(c1)

    log(mix64(1))
    log(mix64(2))
    log(mix64(1) neq mix64(2))

    crc1 is simple_crc('hello')
    crc2 is simple_crc('hello')
    crc3 is simple_crc('world')
    log(crc1 equals crc2)
    log(crc1 equals crc3)

    log(mod_pow(2, 10, 1000))
    log(mod_pow(3, 13, 1000))

    log(is_probable_prime(2))
    log(is_probable_prime(17))
    log(is_probable_prime(561))
    log(is_probable_prime(997))
    log(is_probable_prime(1000))
