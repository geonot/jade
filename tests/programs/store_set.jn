store users
    name as String
    age as i64

*main
    insert users 'Alice', 30
    insert users 'Bob', 25
    insert users 'Charlie', 35

    n is count users
    log n

    set users where name equals 'Bob' age 99

    match users where name equals 'Bob'
        Ok(updated) ?
            log updated.name
            log updated.age
        Err(e) ? log 'miss'
