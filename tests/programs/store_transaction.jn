store Users
    name as String
    age as i64

*main
    transaction
        insert Users 'Alice', 30
        insert Users 'Bob', 25
        insert Users 'Charlie', 35
    c is count Users
    log c
    match Users where name equals 'Bob'
        Ok(results) ?
            log results.name
            log results.age
        Err(e) ? log 'miss'
