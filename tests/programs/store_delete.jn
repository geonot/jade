store users
    name as String
    age as i64

*main
    insert users 'Alice', 30
    insert users 'Bob', 25
    insert users 'Charlie', 35

    n is count users
    log n

    delete users where age > 28

    n2 is count users
    log n2

    match users where age < 30
        Ok(remaining) ?
            log remaining.name
            log remaining.age
        Err(e) ? log 'miss'
