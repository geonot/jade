
*power_recursive(base, exp)
    if exp equals 0
        return 1
    base * power_recursive(base, exp - 1)

*power_iterative(base, exp)
    result is 1
    for i in 0 to exp
        result is result * base
    result

*power_fast(base, exp)
    result is 1
    b is base
    e is exp
    while e > 0
        if e mod 2 equals 1
            result is result * b
        b is b * b
        e is e / 2
    result

*main
    log(power_recursive(2, 10))
    log(power_iterative(2, 10))
    log(power_fast(2, 10))

    log(power_recursive(3, 5))
    log(power_iterative(3, 5))
    log(power_fast(3, 5))

    log(2 pow 10)
    log(3 pow 5)
