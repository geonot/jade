
*relu(x as f64)
    x > 0.0 ? x ! 0.0

*sigmoid(x as f64)
    if x > 6.0
        return 1.0
    if x < -6.0
        return 0.0
    ax is x.abs()
    (x * 0.5 + 1.0) / (ax + 2.0)

*dot2(a0 as f64, a1 as f64, b0 as f64, b1 as f64)
    a0 * b0 + a1 * b1

type NeuralNet
    w_ih0 as f64
    w_ih1 as f64
    w_ih2 as f64
    w_ih3 as f64
    b_h0 as f64
    b_h1 as f64
    w_ho0 as f64
    w_ho1 as f64
    b_o as f64

    *forward(self, x0 as f64, x1 as f64)
        h0 is relu(x0 * self.w_ih0 + x1 * self.w_ih1 + self.b_h0)
        h1 is relu(x0 * self.w_ih2 + x1 * self.w_ih3 + self.b_h1)
        sigmoid(h0 * self.w_ho0 + h1 * self.w_ho1 + self.b_o)

*mse(predicted as f64, actual as f64)
    diff is predicted - actual
    diff * diff

*main
    net is NeuralNet(
        w_ih0 is 10.0,   w_ih1 is 10.0,
        w_ih2 is 10.0,   w_ih3 is 10.0,
        b_h0 is -5.0,    b_h1 is -15.0,
        w_ho0 is 10.0,   w_ho1 is -20.0,
        b_o is -1.0
    )

    r00 is net.forward(0.0, 0.0)
    r01 is net.forward(0.0, 1.0)
    r10 is net.forward(1.0, 0.0)
    r11 is net.forward(1.0, 1.0)

    log(r00)
    log(r01)
    log(r10)
    log(r11)

    total_error is mse(r00, 0.0) + mse(r01, 1.0) + mse(r10, 1.0) + mse(r11, 0.0)
    log(total_error)

    and_net is NeuralNet(
        w_ih0 is 10.0,  w_ih1 is 10.0,
        w_ih2 is 0.0,   w_ih3 is 0.0,
        b_h0 is -15.0,  b_h1 is 0.0,
        w_ho0 is 10.0,  w_ho1 is 0.0,
        b_o is -1.0
    )

    log(and_net.forward(0.0, 0.0))
    log(and_net.forward(0.0, 1.0))
    log(and_net.forward(1.0, 0.0))
    log(and_net.forward(1.0, 1.0))
