store people
    name as String
    age as i64

*main
    insert people 'Alice', 30
    insert people 'Bob', 25
    insert people 'Charlie', 35
    insert people 'Alice', 22

    match people where name equals 'Bob'
        Ok(found) ?
            log found.name
            log found.age
        Err(e) ? log 'miss'
