
*count_char(s as String, ch as i64)
    count is 0
    for i from 0 to s.length
        if s.char_at(i) equals ch
            count is count + 1
    count

*is_palindrome(s as String)
    left is 0
    right is s.length - 1
    while left < right
        if s.char_at(left) neq s.char_at(right)
            return false
        left is left + 1
        right is right - 1
    true

*count_words(s as String)
    if s.length equals 0
        return 0
    words is 1
    for i from 0 to s.length
        if s.char_at(i) equals 32
            words is words + 1
    words

*caesar_shift(ch as i64, shift as i64)
    if ch >= 97 and ch <= 122
        return ((ch - 97 + shift) mod 26) + 97
    if ch >= 65 and ch <= 90
        return ((ch - 65 + shift) mod 26) + 65
    ch

*matches_at(s as String, pattern as String, pos as i64)
    if pos + pattern.length > s.length
        return false
    for i from 0 to pattern.length
        if s.char_at(pos + i) neq pattern.char_at(i)
            return false
    true

*count_occurrences(s as String, pattern as String)
    count is 0
    for i from 0 to s.length
        if matches_at(s, pattern, i)
            count is count + 1
    count

*main
    msg is 'hello world'

    log(count_char(msg, 108))
    log(count_char(msg, 111))
    log(count_char(msg, 122))

    log(is_palindrome('racecar'))
    log(is_palindrome('madam'))
    log(is_palindrome('hello'))
    log(is_palindrome('a'))

    log(count_words('hello world'))
    log(count_words('the quick brown fox'))
    log(count_words('single'))

    x is 42
    log('the answer is {x}')
    log('double: {x * 2}, triple: {x * 3}')

    log(msg.contains('world'))
    log(msg.starts_with('hello'))
    log(msg.ends_with('world'))

    sub is msg.slice(0, 5)
    log(sub)

    log(count_occurrences('abcabcabc', 'abc'))
    log(count_occurrences('aaa', 'aa'))
