
*make_adder(n as i64)
    |x as i64| x + n

*make_multiplier(n as i64)
    |x as i64| x * n

*apply(f as (i64) returns i64, x as i64)
    f(x)

*apply_to_range(f as (i64) returns i64, start as i64, end_val as i64)
    total is 0
    for i from start to end_val
        total is total + f(i)
    total

*transform(x as i64)
    add5 is make_adder(5)
    dbl is make_multiplier(2)

    result is dbl(add5(x))
    result

*main
    add10 is make_adder(10)
    log(add10(5))
    log(add10(100))

    mul3 is make_multiplier(3)
    log(mul3(7))

    log(apply(add10, 32))

    double is make_multiplier(2)
    total is apply_to_range(double, 1, 11)
    log(total)

    log(transform(10))
    log(transform(0))

    sq is |x as i64| x * x
    log(sq(9))

    add3 is make_adder(3)
    mul2 is make_multiplier(2)
    result is mul2(add3(5))
    log(result)

    outer is 100
    f is |x as i64| x + outer
    log(f(42))
