


*overflow_demo
    max_i64 is 9223372036854775807

    w is wrapping_add(max_i64, 1)
    log(w)

    s is saturating_add(max_i64, 1)
    log(s)

    result, did_overflow is checked_add(max_i64, 1)
    log(did_overflow)

    log(wrapping_sub(0, 1))

    min_i64 is -9223372036854775807 - 1
    log(saturating_sub(min_i64, 1))


*bit_tricks
    x is 0xDEADBEEF

    log(popcount(0xFF))
    log(popcount(0))
    log(popcount(1))

    log(clz(1))
    log(ctz(8))
    log(ctz(16))

    log(bswap(0x0102030405060708))

    log(rotate_left(1, 3))
    log(rotate_right(8, 3))

    n is 1024
    is_pow2 is (n & (n - 1)) equals 0 and n > 0
    log(is_pow2)

    v is 5
    v is v - 1
    v is v | (v >> 1)
    v is v | (v >> 2)
    v is v | (v >> 4)
    v is v | (v >> 8)
    v is v | (v >> 16)
    v is v | (v >> 32)
    v is v + 1
    log(v)


*pointer_demo
    x is 42
    ptr is %x
    val is @ptr
    log(val)


*volatile_demo
    x is 0
    ptr is %x
    volatile_store(ptr, 99)
    v is volatile_load(ptr)
    log(v)


type NetworkHeader @packed @strict
    version as u8
    msg_type as u8
    length as u16
    sequence as u32

type AlignedBuffer @align(64)
    data as i64


*ffi_demo
    log('ffi demo (variadic printf not yet supported)')


*on_signal(sig as i32)
    log(sig)

*signal_demo
    log('signal demo (signal_handle codegen has type mismatch bug)')

*main
    log('=== overflow ===')
    overflow_demo()

    log('=== bits ===')
    bit_tricks()

    log('=== pointers ===')
    pointer_demo()

    log('=== volatile ===')
    volatile_demo()

    log('=== ffi ===')
    ffi_demo()

    log('=== signals ===')
    signal_demo()

    log('=== done ===')
