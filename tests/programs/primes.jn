
*is_prime(n)
    if n < 2
        return false
    if n < 4
        return true
    if n mod 2 equals 0
        return false
    d is 3
    while d * d <= n
        if n mod d equals 0
            return false
        d is d + 2
    true

*count_primes(limit)
    count is 0
    for n from 2 to limit
        if is_prime(n)
            count is count + 1
    count

*nth_prime(n)
    count is 0
    candidate is 2
    loop
        if is_prime(candidate)
            count is count + 1
            if count equals n
                return candidate
        candidate is candidate + 1

*main
    for i from 2 to 80
        if is_prime(i)
            log(i)

    log(count_primes(1000))

    log(nth_prime(100))
