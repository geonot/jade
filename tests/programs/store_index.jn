store products
    name as String @index
    price as i64

*main
    insert products 'Apple', 100
    insert products 'Banana', 50
    insert products 'Cherry', 75

    n is count products
    log n

    match products where name equals 'Apple'
        Ok(a) ?
            log a.name
            log a.price
        Err(e) ? log 'miss'
