
*main
    items is vec()
    items.push("a")
    items.push("b")
    items.push("c")
    loop items
        log($)

    loop items
        log(to_string($$) + ":" + $)

    loop 0 to 3
        log(to_string($))

    loop 5 to 8
        log(to_string($$) + "=" + to_string($))

    loop 0 to 10 by 3
        log(to_string($))

    loop 1 to 4
        log(to_string($$) + ">" + to_string($))

    for i in 0 to 3
        log(to_string(i))
