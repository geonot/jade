
*equals(a as i64, b as i64) returns bool
    a equals b

*pow(base as i64, n as i64) returns i64
    result is 1 as i64
    i is 0 as i64
    while i < n
        result is result * base
        i is i + 1
    result

*main
    eq is 5 as i64
    neq is 3 as i64
    total is 0 as i64
    if eq < 0
        total is total + 1
    else
        total is total + eq
    total is total + neq
    if equals(eq, 5)
        total is total + 100
    log(total + pow(2, 3))
