# guide_tour.jn
#
# A comprehensive tour that exercises the features documented in jinn.md.
# Every section prints results that can be eyeballed against the expected
# values in the trailing comments. Run with:
#
#     target/release/jinnc run snippets/guide_tour.jn

# ---------------------------------------------------------------------------
# Strings: single quotes interpolate, double quotes are raw.
# ---------------------------------------------------------------------------
*strings_demo
    name is 'world'
    log('hello {name}')            # hello world
    log("hello {name}")            # hello {name}   (raw)

    x is 42
    log('x={x}, doubled={x * 2}')  # x=42, doubled=84

    s is 'Jinn Language'
    log(s.length)                  # 13
    log(s.to_upper())              # JINN LANGUAGE
    log(s.contains('Lang'))        # true
    log(s.slice(0, 4))             # Jinn

# ---------------------------------------------------------------------------
# Operators: chained comparison, logical, membership, arithmetic, casting.
# ---------------------------------------------------------------------------
*operators_demo
    x is 50
    if 0 < x < 100
        log('in range')           # in range

    a is true
    b is false
    if a and not b
        log('a only')             # a only
    if a xor b
        log('exactly one')        # exactly one

    if 3 in [1, 2, 3]
        log('found')              # found
    if 'lo' in 'hello'
        log('substring')          # substring

    log(2 pow 10)                 # 1024
    log(17 mod 5)                 # 2
    log(0xF0 & 0x0F)              # 0
    log(1 << 4)                   # 16

    big is 300
    log(big as i16)               # 300  (truncating cast fits here)
    y is 7 as f64
    log(y)                        # 7.000000

# ---------------------------------------------------------------------------
# Control flow: if/elif/else, ternary, while, for, loop(...), labeled break.
# ---------------------------------------------------------------------------
*classify n
    if n > 0
        'positive'
    elif n equals 0
        'zero'
    else
        'negative'

*control_demo
    log(classify(5))              # positive
    log(classify(0))              # zero
    log(classify(-3))             # negative

    grade is 85 > 90 ? 'A' ! 85 > 80 ? 'B' ! 'C'
    log(grade)                    # B

    n is 3
    total is 0
    while n > 0
        total is total + n
        n is n - 1
    log(total)                    # 6

    acc is 0
    for i in 1 to 5
        acc is acc + i
    log(acc)                      # 10  (1+2+3+4)... 1 to 5 is exclusive end

    items is ['a', 'b', 'c']
    loop(0, $ < items.len(), $ + 1)
        log(items.get($))         # a b c

    hit is 0
    outer is for i in 0 to 10
        for j in 0 to 10
            if i * j > 6
                hit is i * j
                break outer
    log(hit)                      # 8  (i=2,j=4 -> 8)

# ---------------------------------------------------------------------------
# Functions: inference, early return, defaults/named args, inline, clauses, HOF.
# ---------------------------------------------------------------------------
*add a, b
    a + b

*fib n
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)

*connect(host as String, port as i64 is 8080)
    'connecting to {host}:{port}'

*double x is x * 2

*gcd(a, 0) is a
*gcd a, b is gcd(b, a % b)

*apply(f as (i64) returns i64, x as i64)
    f(x)

*functions_demo
    log(add(1, 2))                # 3
    log(fib(10))                  # 55
    log(connect('localhost'))     # connecting to localhost:8080
    log(connect(host is 'db', port is 3000))  # connecting to db:3000
    log(double(21))               # 42
    log(gcd(48, 18))              # 6
    log(apply(double, 9))         # 18

# ---------------------------------------------------------------------------
# Lambdas and pipelines.
# ---------------------------------------------------------------------------
*normalize s is s.trim().to_lower()
*shout s is s.to_upper()
*add5(a as i64, b as i64) is a + b

*pipeline_demo
    square is |x| x * x
    log(square(6))                # 36

    loud is '  Hello  ' ~ normalize ~ shout
    log(loud)                     # HELLO

    placed is 10 ~ add5(5, $)     # add5(5, 10)
    log(placed)                   # 15

# ---------------------------------------------------------------------------
# Types with implicit-self methods and a default field.
# ---------------------------------------------------------------------------
type Vec3
    x as f64
    y as f64
    z as f64

    *dot(other as Vec3)
        x * other.x + y * other.y + z * other.z

    *length()
        (x * x + y * y + z * z).sqrt()

type Config
    retries is 3
    host as String

*types_demo
    a is Vec3(x is 1.0, y is 2.0, z is 2.0)
    b is Vec3(x is 1.0, y is 0.0, z is 0.0)
    log(a.dot(b))                 # 1.000000
    log(a.length())               # 3.000000

    c is Config(host is 'api')
    log(c.retries)                # 3
    log(c.host)                   # api

# ---------------------------------------------------------------------------
# Enums and pattern matching.
# ---------------------------------------------------------------------------
enum Shape
    Circle(f64)
    Rect(f64, f64)
    Unit

*area(s as Shape) returns f64
    match s
        Circle(r) ? 3.14159 * r * r
        Rect(w, h) ? w * h
        Unit ? 0.0

*enums_demo
    log(area(Circle(2.0)))        # 12.566360
    log(area(Rect(3.0, 4.0)))     # 12.000000
    log(area(Unit))               # 0.000000

# ---------------------------------------------------------------------------
# Generics.
# ---------------------------------------------------------------------------
*max_of of T(a as T, b as T)
    a > b ? a ! b

*generics_demo
    log(max_of(3, 9))             # 9
    log(max_of(2.5, 1.5))         # 2.500000

# ---------------------------------------------------------------------------
# Collections: vec, map, and array-literal -> vector inference.
# ---------------------------------------------------------------------------
*collections_demo
    v is vec()
    v.push(1)
    v.push(2)
    log(v.len())                  # 2
    log(v.get(0))                 # 1

    m is map()
    m.set('key', 42)
    log(m.get('key'))             # 42
    log(m.has('key'))             # true

    nums is [10, 20, 30]
    log(nums.get(1))              # 20

    queue is [1, 2, 3]
    queue.push(4)                 # inferred as a vector
    log(queue.len())              # 4

# ---------------------------------------------------------------------------
# Comprehensions and functional combinators.
# ---------------------------------------------------------------------------
*comprehensions_demo
    squares is [x pow 2 for x in 0 to 5]
    log(squares.get(4))           # 16

    evens is [x for x in 0 to 10 if x mod 2 equals 0]
    log(evens.len())              # 5

    nums is [1, 2, 3, 4]
    doubled is nums.map(|x| x * 2)
    log(doubled.get(3))           # 8
    total is nums.fold(0, |acc, x| acc + x)
    log(total)                    # 10

# ---------------------------------------------------------------------------
# Generators.
# ---------------------------------------------------------------------------
*counter()
    n is 0
    loop
        yield n
        n is n + 1

*generators_demo
    g is counter()
    log(g.next())                 # 0
    log(g.next())                 # 1
    log(g.next())                 # 2

# ---------------------------------------------------------------------------
# Error handling as values.
# ---------------------------------------------------------------------------
enum CheckResult
    Ok(i64)
    Err(i64)

*checked_add(a as i64, b as i64) returns CheckResult
    sum is a + b
    if sum > 100
        return Err(sum)
    Ok(sum)

*errors_demo
    match checked_add(60, 30)
        Ok(v) ? log(v)            # 90
        Err(e) ? log(0 - e)
    match checked_add(60, 50)
        Ok(v) ? log(v)
        Err(e) ? log(0 - e)       # -110

# ---------------------------------------------------------------------------
*main
    log('== strings ==')
    strings_demo()
    log('== operators ==')
    operators_demo()
    log('== control ==')
    control_demo()
    log('== functions ==')
    functions_demo()
    log('== pipeline ==')
    pipeline_demo()
    log('== types ==')
    types_demo()
    log('== enums ==')
    enums_demo()
    log('== generics ==')
    generics_demo()
    log('== collections ==')
    collections_demo()
    log('== comprehensions ==')
    comprehensions_demo()
    log('== generators ==')
    generators_demo()
    log('== errors ==')
    errors_demo()
    log('== done ==')
