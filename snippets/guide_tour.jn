
*strings_demo
    name is 'world'
    log('hello {name}')
    log("hello {name}")

    x is 42
    log('x={x}, doubled={x * 2}')

    s is 'Jinn Language'
    log(s.length)
    log(s.to_upper())
    log(s.contains('Lang'))
    log(s.slice(0, 4))

*operators_demo
    x is 50
    if 0 < x < 100
        log('in range')

    a is true
    b is false
    if a and not b
        log('a only')
    if a xor b
        log('exactly one')

    if 3 in [1, 2, 3]
        log('found')
    if 'lo' in 'hello'
        log('substring')

    log(2 pow 10)
    log(17 mod 5)
    log(0xF0 & 0x0F)
    log(1 << 4)

    big is 300
    log(big as i16)
    y is 7 as f64
    log(y)

*classify n
    if n > 0
        'positive'
    elif n equals 0
        'zero'
    else
        'negative'

*control_demo
    log(classify(5))
    log(classify(0))
    log(classify(-3))

    grade is 85 > 90 ? 'A' ! 85 > 80 ? 'B' ! 'C'
    log(grade)

    n is 3
    total is 0
    while n > 0
        total is total + n
        n is n - 1
    log(total)

    acc is 0
    for i in 1 to 5
        acc is acc + i
    log(acc)

    items is ['a', 'b', 'c']
    loop(0, $ < items.len(), $ + 1)
        log(items.get($))

    hit is 0
    outer is for i in 0 to 10
        for j in 0 to 10
            if i * j > 6
                hit is i * j
                break outer
    log(hit)

*add a, b
    a + b

*fib n
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)

*connect(host as String, port as i64 is 8080)
    'connecting to {host}:{port}'

*double x is x * 2

*gcd(a, 0) is a
*gcd a, b is gcd(b, a % b)

*apply(f as (i64) returns i64, x as i64)
    f(x)

*functions_demo
    log(add(1, 2))
    log(fib(10))
    log(connect('localhost'))
    log(connect(host is 'db', port is 3000))
    log(double(21))
    log(gcd(48, 18))
    log(apply(double, 9))

*normalize s is s.trim().to_lower()
*shout s is s.to_upper()
*add5(a as i64, b as i64) is a + b

*pipeline_demo
    square is |x| x * x
    log(square(6))

    loud is '  Hello  ' ~ normalize ~ shout
    log(loud)

    placed is 10 ~ add5(5, $)
    log(placed)

type Vec3
    x as f64
    y as f64
    z as f64

    *dot(other as Vec3)
        x * other.x + y * other.y + z * other.z

    *length()
        (x * x + y * y + z * z).sqrt()

type Config
    retries is 3
    host as String

*types_demo
    a is Vec3(x is 1.0, y is 2.0, z is 2.0)
    b is Vec3(x is 1.0, y is 0.0, z is 0.0)
    log(a.dot(b))
    log(a.length())

    c is Config(host is 'api')
    log(c.retries)
    log(c.host)

enum Shape
    Circle(f64)
    Rect(f64, f64)
    Unit

*area(s as Shape) returns f64
    match s
        Circle(r) ? 3.14159 * r * r
        Rect(w, h) ? w * h
        Unit ? 0.0

*enums_demo
    log(area(Circle(2.0)))
    log(area(Rect(3.0, 4.0)))
    log(area(Unit))

*max_of of T(a as T, b as T)
    a > b ? a ! b

*generics_demo
    log(max_of(3, 9))
    log(max_of(2.5, 1.5))

*collections_demo
    v is vec()
    v.push(1)
    v.push(2)
    log(v.len())
    log(v.get(0))

    m is map()
    m.set('key', 42)
    log(m.get('key'))
    log(m.has('key'))

    nums is [10, 20, 30]
    log(nums.get(1))

    queue is [1, 2, 3]
    queue.push(4)
    log(queue.len())

*comprehensions_demo
    squares is [x pow 2 for x in 0 to 5]
    log(squares.get(4))

    evens is [x for x in 0 to 10 if x mod 2 equals 0]
    log(evens.len())

    nums is [1, 2, 3, 4]
    doubled is nums.map(|x| x * 2)
    log(doubled.get(3))
    total is nums.fold(0, |acc, x| acc + x)
    log(total)

*counter()
    n is 0
    loop
        yield n
        n is n + 1

*generators_demo
    g is counter()
    log(g.next())
    log(g.next())
    log(g.next())

enum CheckResult
    Ok(i64)
    Err(i64)

*checked_add(a as i64, b as i64) returns CheckResult
    sum is a + b
    if sum > 100
        return Err(sum)
    Ok(sum)

*errors_demo
    match checked_add(60, 30)
        Ok(v) ? log(v)
        Err(e) ? log(0 - e)
    match checked_add(60, 50)
        Ok(v) ? log(v)
        Err(e) ? log(0 - e)

*main
    log('== strings ==')
    strings_demo()
    log('== operators ==')
    operators_demo()
    log('== control ==')
    control_demo()
    log('== functions ==')
    functions_demo()
    log('== pipeline ==')
    pipeline_demo()
    log('== types ==')
    types_demo()
    log('== enums ==')
    enums_demo()
    log('== generics ==')
    generics_demo()
    log('== collections ==')
    collections_demo()
    log('== comprehensions ==')
    comprehensions_demo()
    log('== generators ==')
    generators_demo()
    log('== errors ==')
    errors_demo()
    log('== done ==')
