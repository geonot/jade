use std/csv
use std/strings

*build_text(rows as i64) returns String
    sb is strings.builder()
    r is 0
    while r < rows
        sb.write('id')
        sb.write(to_string(r))
        sb.write(',')
        sb.write('"name ""')
        sb.write(to_string(r mod 97))
        sb.write('"", inc",')
        sb.write(to_string(r * 31 mod 1009))
        sb.write(',city')
        sb.write(to_string(r mod 53))
        sb.write(',#')
        sb.write(to_string(r mod 7))
        sb.write(',tail')
        sb.write('\n')
        r is r + 1
    sb.to_string()

*main
    text is build_text(1500)
    total is 0
    rep is 0
    while rep < 3
        rows is csv.parse(text)
        loop rows
            row is $
            loop row
                total is total + $.byte_count
        rep is rep + 1
    log(total)
