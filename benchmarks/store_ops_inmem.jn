
*main
    keys is vec(0)
    keys.pop()
    vals is vec(0)
    vals.pop()
    for i in 0 to 10000
        keys.push(i)
        vals.push(i * 7)

    total is 0
    for j in 0 to 1000
        idx is -1
        for k in 0 to keys.length
            if keys[k] equals j
                idx is k
        if idx >= 0
            total is total + vals[idx]

    log(total)
    log(keys.length)
