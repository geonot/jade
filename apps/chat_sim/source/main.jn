
extern *jinn_time_now_ns() returns i64

*fib(n as i64) returns i64
    if n < 2
        n
    else
        fib(n - 1) + fib(n - 2)

actor User
    processed as i64
    user_id as i64
    @init id as i64
        user_id is id
        processed is 0
    @receive_msg msg_id as i64
        result is fib(25 + msg_id % 5)
        processed is processed + 1
    @status
        log(user_id)
        log(processed)

*main
    log("=== Chat Room Simulation ===")
    t0 is jinn_time_now_ns()

    u0 is spawn User
    u1 is spawn User
    u2 is spawn User
    u3 is spawn User

    u0.init(0)
    u1.init(1)
    u2.init(2)
    u3.init(3)

    msg is 0
    while msg < 40
        u0.receive_msg(msg)
        u1.receive_msg(msg)
        u2.receive_msg(msg)
        u3.receive_msg(msg)
        msg is msg + 1

    u0.status()
    u1.status()
    u2.status()
    u3.status()

    t1 is jinn_time_now_ns()
    elapsed_ms is (t1 - t0) / 1000000
    log("Elapsed ms:")
    log(elapsed_ms)
    log("Messages per user: 40")
    log("Total messages processed: 160")
