use models/token
use lexer
use parser
use renderer

*encode_line(cls as i64, payload as i64) returns i64
    cls * 1000 + payload

*main
    lines is vec()
    lines.push(encode_line(1, 3))
    lines.push(encode_line(5, 8))
    lines.push(encode_line(5, 12))
    lines.push(encode_line(4, 0))
    lines.push(encode_line(1, 5))
    lines.push(encode_line(2, 4))
    lines.push(encode_line(2, 6))
    lines.push(encode_line(2, 3))
    lines.push(encode_line(4, 0))
    lines.push(encode_line(3, 0))
    lines.push(encode_line(5, 20))
    lines.push(encode_line(5, 15))
    lines.push(encode_line(3, 0))
    lines.push(encode_line(5, 7))
    lines.push(encode_line(1, 9))

    tokens is lexer.tokenize(lines)
    blocks is parser.parse(tokens)

    log 'lines'
    log lines.len()
    log 'tokens'
    log tokens.len()
    log 'blocks'
    log blocks.len()
    log 'headings'
    log renderer.headings(blocks)
    log 'words'
    log renderer.total_words(blocks)
    log 'tags'
    log renderer.tag_count(blocks)
