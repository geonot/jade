
use memory
use syscalls
use scheduler
use process
use shell

*main
    log 'jinn-microkernel boot'

    mmu  is memory.boot(64)
    sys  is spawn Kernel
    sch  is spawn Scheduler

    init is process.spawn_task('init', 0, sys, mmu)
    sch.admit(init, 0)

    loop(1, $ <= 4, $ + 1)
        pid  is $
        prio is 5 - $
        name is 'worker_{pid}'
        t    is process.spawn_task(name, pid, sys, mmu)
        sch.admit(t, prio)

    sch.tick(20)

    sh is spawn Shell
    sh.exec('alloc 8')
    sh.exec('alloc 16')
    sh.exec('write 0x100 42')
    sh.exec('read  0x100')
    sh.exec('fork  worker')
    sh.exec('ps')
    sh.exec('halt')

    sch.tick(8)
    sch.report()
    sys.report()

    stop sh
    stop sch
    stop sys
    log 'jinn-microkernel halt'
