
actor Shell
    n_cmds as i64

    *exec line as String
        n_cmds is n_cmds + 1
        c is line.char_at(0)
        if c equals 97
            log 'sh: alloc ok'
        if c equals 114
            log 'sh: read ok'
        if c equals 119
            log 'sh: write ok'
        if c equals 102
            log 'sh: fork ok'
        if c equals 112
            log 'sh: ps -> 5 tasks'
        if c equals 104
            log 'sh: halting'
